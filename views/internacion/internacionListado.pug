extends ../layout

block content
  .toast-container.position-fixed.top-0.end-0.p-3(style="z-index: 1080;")
    #toastSuccess.toast.align-items-center.text-white.bg-success.border-0(role="alert", aria-live="assertive", aria-atomic="true")
      .d-flex
        .toast-body
          i.bi.bi-check-circle-fill.me-2
          span#toastSuccessTexto La internación hospitalaria del paciente fue registrada con éxito.
        button.btn.btn-close.btn-close-white.me-2.m-auto(type="button", data-bs-dismiss="toast", aria-label="Close")

    // Ventanita flotante roja para rechazos lógicos
    #toastError.toast.align-items-center.text-white.bg-danger.border-0(role="alert", aria-live="assertive", aria-atomic="true")
      .d-flex
        .toast-body
          i.bi.bi-exclamation-octagon-fill.me-2
          span#toastErrorTexto Ocurrió un error inesperado.
        button.btn.btn-close.btn-close-white.me-2.m-auto(type="button", data-bs-dismiss="toast", aria-label="Close")

  .container.mt-4
    // Mensaje para avisar de DNI duplicado en pacientes NN
    #alertaError.alert.alert-danger.alert-dismissible.fade.show.d-none(role="alert")
      i.bi.bi-exclamation-triangle-fill.me-2
      strong ¡Error!
      |  El DNI ingresado ya pertenece a otro paciente registrado en el sistema.
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

    .d-flex.justify-content-between.align-items-center.mb-4
      h2.mb-0 Listado de Internaciones
      
      .d-flex.align-items-center
        label.fw-bold.me-2.text-nowrap(for="filtroEstado") Filtrar vista:
        select#filtroEstado.form-select.border-primary.fw-bold(style="width: auto; cursor: pointer;")
          option(value="Activa" selected) 🏥 Solo Internados (Activas)
          option(value="") 📁 Historial Completo (Todas)
          option(value="Alta Firmada") ✔️ Solo Altas Firmadas
          option(value="Anulada") ✖️ Solo Anuladas

    table#tablaInternaciones.table.table-bordered.table-hover
      thead
        tr
          th Paciente
          th DNI
          th Sexo
          th Fecha y Hora de Ingreso
          th Motivo
          th Ala
          th Habitación
          th Cama
          th Estado Cama
          th Estado Internación
          th Género en la Cama
          th Acciones
      tbody
        each internacion in internaciones
          tr
            td
              if internacion.Paciente && internacion.Paciente.dni.startsWith('NN-')
                span.badge.bg-danger.me-2 ⚠️ Emergencia NN
              else
                | #{internacion.Paciente ? internacion.Paciente.nombre + ' ' + internacion.Paciente.apellido : 'N/D'}
                
            td= internacion.Paciente ? internacion.Paciente.dni : 'N/D'
            td= internacion.Paciente ? internacion.Paciente.genero : 'N/D'

            - var fecha = new Date(internacion.fecha_ingreso);
            - var fechaStr = !isNaN(fecha) ? fecha.toLocaleDateString('es-AR') : '-';
            - var horaStr = !isNaN(fecha) ? fecha.toLocaleTimeString('es-AR', {hour: '2-digit', minute:'2-digit', hour12: false}) : '';
            td= fechaStr + ' ' + horaStr

            - var motivoDesc = internacion.MotivoInternacion ? internacion.MotivoInternacion.descripcion : '-'
            td= motivoDesc

            - var ala = (internacion.Cama && internacion.Cama.Habitacion && internacion.Cama.Habitacion.Ala) ? internacion.Cama.Habitacion.Ala.nombre : 'N/D'
            td= ala

            - var habitacionNumero = (internacion.Cama && internacion.Cama.Habitacion) ? internacion.Cama.Habitacion.numero : 'N/D'
            td= habitacionNumero

            - var camaNumero = internacion.Cama ? internacion.Cama.numero : 'N/D'
            td= camaNumero

            td
              if internacion.Cama && internacion.Cama.estado === 'Ocupada'
                span.text-danger.fw-bold 🛏️ Ocupada
              else if internacion.Cama && (internacion.Cama.estado === 'Higienizada' || internacion.Cama.estado === 'Disponible')
                span.text-warning.fw-bold 🛏️ Higienizada / Disponible
              else if internacion.Cama && internacion.Cama.estado === 'para_limpieza'
                span.text-info.fw-bold 🧽 Para Limpieza
              else if internacion.Cama && internacion.Cama.estado === 'Libre'
                span.text-success.fw-bold 🛏️ Libre
              else
                span.text-muted 🛏️ N/D

            td
              if internacion.estado === 'Finalizada'
                span.badge.bg-success Alta Firmada
              else if internacion.estado === 'Anulada'
                span.badge.bg-secondary Anulada
              else
                span.badge.bg-primary Activa

            - var generoEnCama = internacion.Paciente ? internacion.Paciente.genero : 'N/D'
            td= generoEnCama

            td.text-center
              if internacion.Paciente && internacion.Paciente.dni.startsWith('NN-')
                button.btn.btn-sm.btn-warning.btn-identificar.me-1(
                  type="button"
                  data-bs-toggle="modal"
                  data-bs-target="#modalIdentificar"
                  data-id=internacion.Paciente.id_paciente
                  data-dni=internacion.Paciente.dni
                  title="Identificar Paciente NN"
                )
                  i.bi.bi-person-check-fill
              
              // Botones para internaciones activas
              if internacion.estado === 'Activa'
                button.btn.btn-sm.btn-warning.me-1(
                  type="button"
                  onclick=`abrirModalTraslado(${internacion.id_internacion}, '${internacion.Paciente ? internacion.Paciente.nombre + " " + internacion.Paciente.apellido : "Paciente"}')`
                  title="Trasladar paciente de habitación y cama"
                )
                  i.bi.bi-arrows-move.me-1
                  | Trasladar

                button.btn.btn-sm.btn-outline-danger(
                  type="button"
                  onclick=`anularInternacionDirecto(${internacion.id_internacion})`
                  title="Anular internación y liberar cama automáticamente"
                )
                  i.bi.bi-x-circle-fill.me-1
                  | Anular
              else if !internacion.Paciente || !internacion.Paciente.dni.startsWith('NN-')
                span.text-muted -

    // Modal Identificar Paciente NN
    #modalIdentificar.modal.fade(tabindex="-1" aria-labelledby="modalIdentificarLabel" aria-hidden="true")
      .modal-dialog.modal-md
        .modal-content
          .modal-header.bg-warning.text-dark
            h5#modalIdentificarLabel.modal-title
              i.bi.bi-person-check-fill.me-2
              | Identificar Paciente NN
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body
            p.text-muted Asigne la identidad real al registro temporal: 
              strong#textDniTemporal ...
            
            form#formIdentificar(method="POST")
              .mb-3
                label.form-label.fw-bold DNI Real
                .input-group
                  input#inputDniNN.form-control(type="number" name="dni" required min="1000000" max="999999999" placeholder="Ingrese DNI y presione Buscar...")
                  button#btnBuscarDniNN.btn.btn-primary(type="button")
                    i.bi.bi-search.me-1
                    | Buscar
                small#msgBusquedaDni.form-text.d-block.mt-1

              .row.mb-3
                .col-md-6
                  label.form-label.fw-bold Nombre Real
                  input#inputNombreNN.form-control(type="text" name="nombre" required minlength="2" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+" title="Solo se permiten letras y espacios")
                .col-md-6
                  label.form-label.fw-bold Apellido Real
                  input#inputApellidoNN.form-control(type="text" name="apellido" required minlength="2" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ\\s]+" title="Solo se permiten letras y espacios")
              .row.mb-3
                .col-md-6
                  label.form-label.fw-bold Género
                  select#selectGeneroNN.form-select(name="genero" required)
                    option(value="" disabled selected) Seleccione...
                    option(value="Masculino") Masculino
                    option(value="Femenino") Femenino
                    option(value="Otro") Otro
                .col-md-6
                  label.form-label.fw-bold Edad
                  input#inputEdadNN.form-control(type="number" name="edad" min="0" max="130")
              .row.mb-3
                .col-md-6
                  label.form-label.fw-bold Obra Social
                  select#selectObraSocialNN.form-select(name="id_obra_social")
                    option(value="") Seleccione... / No Posee
                    if obrasSociales
                      each os in obrasSociales
                        option(value=os.id_obra_social)= os.nombre
                .col-md-6
                  label.form-label.fw-bold Teléfono
                  input#inputTelefonoNN.form-control(type="text" name="telefono" pattern="[0-9]{7,15}" title="Ingrese un número de teléfono válido")
                
              .modal-footer.pe-0.pb-0
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-warning.fw-bold(type="submit") Guardar Identidad

    // Modal Flotante de Traslado de Habitación
    #modalTraslado.modal.fade(tabindex="-1" aria-labelledby="modalTrasladoLabel" aria-hidden="true")
      .modal-dialog.modal-md
        .modal-content
          .modal-header.bg-warning.text-dark
            h5#modalTrasladoLabel.modal-title
              i.bi.bi-arrows-move.me-2
              | Traslado de Habitación y Cama
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body
            p.text-muted Reubicando al paciente: 
              strong#textPacienteTraslado ...
            
            form#formTraslado
              input#trasladoInternacionId(type="hidden")
              
              .mb-3
                label.form-label.fw-bold Nueva Habitación Destino
                select#selectHabitacion.form-select(required)
                  option(value="" selected disabled) -- Seleccione Habitación --
                  if habitaciones
                    each hab in habitaciones
                      option(value=hab.id_habitacion) Habitación #{hab.numero} (Capacidad total: #{hab.capacidad})
              
              .mb-3
                label.form-label.fw-bold Nueva Cama Destino
                select#selectCama.form-select(required disabled)
                  option(value="" selected disabled) -- Seleccione primero una habitación --

              .modal-footer.pe-0.pb-0
                button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
                button.btn.btn-warning.fw-bold(type="button" onclick="ejecutarTrasladoDirecto()") Confirmar Traslado

    hr
    h5.mt-4 Leyenda de Camas:
    p
      span.text-success.fw-bold 🛏️ Libre
      |  |  
      span.text-info.fw-bold 🧽 Para Limpieza
      |  |  
      span.text-danger.fw-bold 🛏️ Ocupada

block scripts
  script.
    $(document).ready(function() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('error') === 'dni_duplicado') {
        $('#alertaError').removeClass('d-none');
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      if (urlParams.get('success') === '1') {
        dispararToastSuccess('La internación hospitalaria fue registrada con éxito.');
        window.history.replaceState({}, document.title, window.location.pathname);
      }

      const tabla = $('#tablaInternaciones').DataTable({
        language: {
          url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
        },
        pageLength: 5,
        lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Todos"]],
        order: [[3, "desc"]]
      });

      tabla.column(9).search('Activa').draw();

      $('#filtroEstado').on('change', function() {
        tabla.column(9).search(this.value).draw();
      });

      // Resetear formulario al abrir modal de identificación NN
      $('#tablaInternaciones tbody').on('click', '.btn-identificar', function() {
        const idPaciente = $(this).attr('data-id');
        const dniTemporal = $(this).attr('data-dni');

        $('#textDniTemporal').text(dniTemporal);
        $('#formIdentificar').attr('action', '/pacientes/identificar/' + idPaciente);
        $('#formIdentificar')[0].reset();
        $('#msgBusquedaDni').text('').removeClass('text-success text-info text-danger');
      });

      // Buscar paciente existente por DNI y autocompletar
      $('#btnBuscarDniNN').on('click', function() {
        const dni = $('#inputDniNN').val().trim();
        const $msg = $('#msgBusquedaDni');

        if (!dni || dni.length < 6) {
          $msg.text('Ingrese un DNI válido de al menos 6 dígitos.').removeClass('text-success text-info').addClass('text-danger');
          return;
        }

        $msg.text('Buscando en el padrón...').removeClass('text-success text-danger').addClass('text-info');

        $.ajax({
          url: `/pacientes/buscar-dni/${dni}`,
          method: 'GET',
          success: function(res) {
            if (res.encontrado && res.paciente) {
              const p = res.paciente;
              $('#inputNombreNN').val(p.nombre);
              $('#inputApellidoNN').val(p.apellido);
              $('#selectGeneroNN').val(p.genero);
              $('#inputEdadNN').val(p.edad);
              $('#selectObraSocialNN').val(p.id_obra_social);
              $('#inputTelefonoNN').val(p.telefono);

              $msg.text('✅ Paciente encontrado en el sistema. Datos cargados automáticamente.')
                  .removeClass('text-info text-danger')
                  .addClass('text-success fw-bold');
            } else {
              $msg.text('ℹ️ Paciente no registrado previamente. Complete los datos para darle de alta.')
                  .removeClass('text-success text-danger')
                  .addClass('text-info');
            }
          },
          error: function() {
            $msg.text('Error al consultar el DNI en el servidor.').removeClass('text-success text-info').addClass('text-danger');
          }
        });
      });

      // Manejador de cambio de habitación para rellenar las camas vía AJAX
      $('#selectHabitacion').on('change', function() {
        const idHabitacion = $(this).val();
        const $selectCama = $('#selectCama');

        if (!idHabitacion) {
          $selectCama.html('<option value="" disabled selected>-- Seleccione primero una habitación --</option>').prop('disabled', true);
          return;
        }

        $.ajax({
          url: `/habitaciones/${idHabitacion}/camas`,
          method: 'GET',
          success: function(res) {
            let opciones = '<option value="" disabled selected>-- Seleccione Cama --</option>';
            if (res && res.length > 0) {
              res.forEach(cama => {
                const est = cama.estado.toLowerCase();
                if (['libre', 'disponible', 'higienizada'].includes(est)) {
                  opciones += `<option value="${cama.id_cama}">Cama ${cama.numero} (${cama.estado})</option>`;
                } else {
                  opciones += `<option value="${cama.id_cama}" disabled>Cama ${cama.numero} (${cama.estado} ❌)</option>`;
                }
              });
            } else {
              opciones = '<option value="" disabled>No hay camas en esta habitación</option>';
            }
            $selectCama.html(opciones).prop('disabled', false);
          },
          error: function() {
            mostrarToastError('No se pudieron cargar las camas de la habitación.');
          }
        });
      });
    });

    function anularInternacionDirecto(idInternacion) {
      $.ajax({
        url: `/internacion/${idInternacion}/anular`,
        method: 'PUT',
        success: function(res) {
          dispararToastSuccess(res.message || 'Internación anulada con éxito.');
          setTimeout(() => { location.reload(); }, 1500);
        },
        error: function(err) {
          const msg = err.responseJSON?.error || 'No se pudo procesar la anulación de la internación.';
          mostrarToastError(msg);
        }
      });
    }

    function abrirModalTraslado(idInternacion, nombreCompleto) {
      $('#trasladoInternacionId').val(idInternacion);
      $('#textPacienteTraslado').text(nombreCompleto);
      
      $('#selectHabitacion').val('');
      $('#selectCama').html('<option value="" disabled selected>-- Seleccione primero una habitación --</option>').prop('disabled', true);
      
      const myModal = new bootstrap.Modal(document.getElementById('modalTraslado'));
      myModal.show();
    }

    function ejecutarTrasladoDirecto() {
      const idInternacion = $('#trasladoInternacionId').val();
      const idNuevaHabitacion = $('#selectHabitacion').val();
      const idNuevaCama = $('#selectCama').val();

      if (!idNuevaHabitacion || !idNuevaCama) {
        mostrarToastError('Debe seleccionar una habitación y una cama de destino.');
        return;
      }

      $.ajax({
        url: `/internacion/${idInternacion}/trasladar`,
        method: 'PUT',
        contentType: 'application/json',
        data: JSON.stringify({
          id_nueva_habitacion: idNuevaHabitacion,
          id_nueva_cama: idNuevaCama
        }),
        success: function(res) {
          bootstrap.Modal.getInstance(document.getElementById('modalTraslado')).hide();
          dispararToastSuccess(res.message || 'Paciente trasladado con éxito.');
          setTimeout(() => { location.reload(); }, 1500);
        },
        error: function(err) {
          const msg = err.responseJSON?.error || 'No se pudo realizar el traslado del paciente.';
          mostrarToastError(msg);
        }
      });
    }

    function dispararToastSuccess(mensaje) {
      $('#toastSuccessTexto').text(mensaje);
      const toastElement = document.getElementById('toastSuccess');
      const bsToast = new bootstrap.Toast(toastElement, { delay: 4000 });
      bsToast.show();
    }

    function mostrarToastError(mensaje) {
      $('#toastErrorTexto').text(mensaje);
      const errorElement = document.getElementById('toastError');
      const bsToast = new bootstrap.Toast(errorElement, { delay: 4500 });
      bsToast.show();
    }