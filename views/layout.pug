doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Sistema Hospitalario

    // Bootstrap CSS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    // Bootstrap Icons
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css")
    // DataTables Bootstrap 5 CSS
    link(rel="stylesheet", href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css")
    // Estilos personalizados
    link(rel="stylesheet", href="/css/layout.css")

    block styles

  body
    // Ventana de transición de bienvenida al iniciar sesión
    if user
      #welcomeOverlay.d-none.position-fixed.top-0.start-0.w-100.h-100.align-items-center.justify-content-center(
        style="background: rgba(15, 23, 42, 0.78); backdrop-filter: blur(4px); z-index: 9999; transition: opacity 0.45s ease; cursor: pointer;"
        onclick="cerrarBienvenida()"
      )
        .card.border-0.shadow-lg.text-center.p-4.p-md-5(style="max-width: 430px; border-radius: 16px;")
          .mb-3
            .bg-primary.bg-opacity-10.text-primary.d-inline-flex.align-items-center.justify-content-center.rounded-circle(style="width: 72px; height: 72px;")
              i.bi.bi-person-check-fill.fs-1
          h4.fw-bold.text-dark.mb-1 ¡Bienvenido/a, #{user.nombre}!
          p.text-muted.mb-3 Has ingresado al sistema del Hospital San Carlos
          span.badge.bg-primary.text-uppercase.px-3.py-2.mb-3 Rol activo: #{user.rol}
          .progress(style="height: 4px;")
            #welcomeBar.progress-bar.bg-primary(role="progressbar" style="width: 100%; transition: width 1.5s linear;")

    // Sidebar
    .sidebar(style="overflow-y: auto;")
      .text-center.mb-3.pt-3.px-2
        h5.text-white.fw-bold Hospital San Carlos 
        
        // Info del usuario logueado, rol y botón de cierre de sesión
        if user
          .mt-2
            span.badge.bg-light.text-dark.px-3.py-2.rounded-pill.shadow-sm
              i.bi.bi-person-circle.me-1
              | #{user.nombre}
            .mt-1
              span.badge.bg-info.text-dark.text-uppercase #{user.rol}
            .mt-2
              a.btn.btn-danger.btn-sm.w-75.fw-bold.shadow-sm(href="/logout")
                i.bi.bi-box-arrow-left.me-1
                | Cerrar Sesión
      
      if user
        nav.nav.flex-column.pb-4
          a.nav-link.text-white(class=activePage == '/inicio' ? 'fw-bold text-primary' : '', href='/inicio')
            i.bi.bi-house-door.me-2
            | Inicio 

          // Gestión Hospitalaria (Solo Admin y Recepción)
          if ['admin', 'recepcion'].includes(user.rol)
            small.text-white-50.px-3.text-uppercase.fw-bold.mt-3.mb-1 Gestión Hospitalaria
            
            a.nav-link.text-white(class=activePage == '/pacientes' ? 'fw-bold text-primary' : '', href='/pacientes')
              i.bi.bi-people-fill.me-2
              | Pacientes 

            a.nav-link.text-white(class=activePage == '/admision' ? 'fw-bold text-primary' : '', href='/admision')
              i.bi.bi-journal-plus.me-2
              | Admisión 

          // Internación y Camas (Admin, Recepción y Enfermería)
          if ['admin', 'recepcion', 'enfermero'].includes(user.rol)
            small.text-white-50.px-3.text-uppercase.fw-bold.mt-3.mb-1 Internación y Camas

            a.nav-link.text-white(class=activePage == '/internacion/nueva' ? 'fw-bold text-primary' : '', href='/internacion/nueva')
              i.bi.bi-plus-circle.me-2
              | Nueva Internación

            a.nav-link.text-white(class=activePage == '/internacion/listado' ? 'fw-bold text-primary' : '', href='/internacion/listado')
              i.bi.bi-table.me-2
              | Listado Internaciones

            a.nav-link.text-white(class=activePage == '/habitaciones/mapa' ? 'fw-bold text-primary' : '', href='/habitaciones/mapa')
              i.bi.bi-grid-3x3-gap-fill.me-2
              | Gestión De Habitaciones

          // Submódulos de Enfermería (Admin y Enfermero)
          if ['admin', 'enfermero'].includes(user.rol)
            small.text-white-50.px-3.text-uppercase.fw-bold.mt-4.mb-1 Módulos Clínicos

            a.nav-link.text-white(class=activePage == '/enfermeria' ? 'fw-bold text-primary' : '', href='/enfermeria')
              i.bi.bi-clipboard-pulse.me-2
              | Enfermería 

          // Submódulos de Médicos (Admin y Médico)
          if ['admin', 'medico'].includes(user.rol)
            if user.rol === 'medico'
              small.text-white-50.px-3.text-uppercase.fw-bold.mt-4.mb-1 Módulos Clínicos

            a.nav-link.text-white(class=activePage == '/medico' ? 'fw-bold text-primary' : '', href='/medico')
              i.bi.bi-stethoscope.me-2
              | Evaluación Médica 

            a.nav-link.text-white(class=activePage == '/medico/historial' ? 'fw-bold text-primary' : '', href='/medico/historial')
              i.bi.bi-clock-history.me-2
              | Historial Médico 

          // Módulo de Emergencia (Admin y Recepción)
          if ['admin', 'recepcion'].includes(user.rol)
            small.text-white-50.px-3.text-uppercase.fw-bold.mt-4.mb-1 Alertas
            a.nav-link.text-danger.fw-bold(class=activePage == '/emergencia/crear' ? 'bg-danger text-white rounded mx-2 px-2' : '', href='/emergencia/crear')
              i.bi.bi-exclamation-triangle-fill.me-2
              | Crear Paciente NN

          // Solo Admins
          if user.rol === 'admin'
            small.text-white-50.px-3.text-uppercase.fw-bold.mt-4.mb-1 Administración
            
            a.nav-link.text-white(class=activePage == '/medico/GestionMedico' ? 'fw-bold text-primary' : '', href='/medico/GestionMedico')
              i.bi.bi-person-vcard.me-2
              | Gestionar Médicos

            a.nav-link.text-white(class=activePage == '/enfermero/GestionEnfermero' ? 'fw-bold text-primary' : '', href='/enfermeria/gestionEnfermero')
              i.bi.bi-person-badge.me-2
              | Gestionar Enfermeros 

    // Contenido principal
    .content
      block content

  // Scripts Base
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js")
  script(src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js")
  script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")

  if user
    script.
      function cerrarBienvenida() {
        const overlay = document.getElementById('welcomeOverlay');
        if (!overlay) return;
        overlay.style.opacity = '0';
        setTimeout(() => overlay.remove(), 450);
      }

      (function () {
        const params = new URLSearchParams(window.location.search);
        if (params.get('bienvenido') === '1') {
          const overlay = document.getElementById('welcomeOverlay');
          const bar = document.getElementById('welcomeBar');
          if (overlay) {
            overlay.classList.remove('d-none');
            overlay.classList.add('d-flex');
            window.history.replaceState({}, document.title, window.location.pathname);
            if (bar) {
              setTimeout(() => { bar.style.width = '0%'; }, 50);
            }
            setTimeout(cerrarBienvenida, 1600);
          }
        }
      })();

  block scripts