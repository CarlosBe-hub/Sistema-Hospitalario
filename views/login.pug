doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Login - Sistema Hospitalario San Carlos
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css")
    style.
      body {
        background-color: #f4f7f6;
        height: 100vh;
        overflow: hidden; 
      }
      .login-container {
        height: 100vh;
      }
      .bg-image {
        background-image: url('https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?q=80&w=2053&auto=format&fit=crop'); 
        background-size: cover;
        background-position: center;
        position: relative;
      }
      .bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(9, 132, 227, 0.85) 0%, rgba(45, 52, 54, 0.95) 100%);
      }
      .glass-panel {
        background: rgba(255, 255, 255, 1);
        box-shadow: -10px 0 30px rgba(0,0,0,0.1);
        z-index: 2;
      }
      .form-control:focus {
        border-color: #0984e3;
        box-shadow: 0 0 0 0.25rem rgba(9, 132, 227, 0.15);
      }
      .input-bg {
        background-color: #f8f9fa !important;
      }

  body
    .container-fluid.p-0
      .row.g-0.login-container

        .col-lg-7.d-none.d-lg-block.bg-image
          .bg-overlay
          .d-flex.flex-column.justify-content-center.align-items-start.h-100.text-white.p-5(style="position: relative; z-index: 1; padding-left: 10% !important;")
            .mb-4
              i.bi.bi-heart-pulse.display-1.text-info
            h1.display-4.fw-bold.mb-3 Hospital San Carlos
            p.lead.fw-light.mb-5.w-75 Sistema Integral de Gestión Clínica, Internación y Administración Médica.
            
            .mt-auto
              p.small.text-white-50.mb-0 © 2026 Universidad de La Punta (ULP)
              p.small.text-white-50 Todos Los Derechos Reservados ©

        .col-lg-5.d-flex.align-items-center.justify-content-center.glass-panel
          .w-100.p-4.p-md-5(style="max-width: 450px;")
            
            .text-center.d-block.d-lg-none.mb-4
              .bg-primary.bg-opacity-10.d-inline-block.p-3.rounded-circle.mb-3
                i.bi.bi-hospital.text-primary.fs-1
              h3.fw-bold.text-dark Hospital San Carlos
            
            h4.fw-bold.text-dark.mb-1 ¡Bienvenido de nuevo!
            p.text-muted.small.mb-4 Por favor, ingrese sus credenciales para continuar.

            if error
              .alert.alert-danger.d-flex.align-items-center.py-2.small.mb-4.border-0.shadow-sm(role="alert")
                i.bi.bi-exclamation-triangle-fill.me-2.fs-5
                div #{error}

            form#formLogin(action="/login", method="POST")
              
              .form-floating.mb-3
                input#email.form-control.input-bg.border-0(type="email", name="email", placeholder="nombre@hospital.com", autocomplete="username", maxlength="100", required)
                label.text-muted(for="email")
                  i.bi.bi-envelope.me-2
                  | Correo Electrónico
              
              .form-floating.mb-3.position-relative
                input#password.form-control.input-bg.border-0.pe-5(type="password", name="password", placeholder="Contraseña", autocomplete="current-password", minlength="6", maxlength="100", required)
                label.text-muted(for="password")
                  i.bi.bi-lock.me-2
                  | Contraseña
                button#togglePassword.btn.btn-link.text-muted.position-absolute.top-50.end-0.translate-middle-y.me-2.p-1(type="button", tabindex="-1", title="Mostrar/ocultar contraseña")
                  i#iconPassword.bi.bi-eye

              .mb-4
                .form-check
                  input#remember.form-check-input(type="checkbox")
                  label.form-check-label.small.text-muted(for="remember") Recordar usuario

              button#btnSubmit.btn.btn-primary.w-100.py-3.fs-6.fw-bold.shadow-sm(type="submit", style="border-radius: 8px;") 
                i.bi.bi-box-arrow-in-right.me-2
                | Ingresar al Panel Operativo

    script.
      document.addEventListener('DOMContentLoaded', function () {
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        const rememberCheck = document.getElementById('remember');
        const formLogin = document.getElementById('formLogin');
        const btnSubmit = document.getElementById('btnSubmit');
        const togglePassword = document.getElementById('togglePassword');
        const iconPassword = document.getElementById('iconPassword');

        // Recuperar correo guardado
        const correoGuardado = localStorage.getItem('hsc_correo_recordado');
        if (correoGuardado) {
          emailInput.value = correoGuardado;
          rememberCheck.checked = true;
        }

        // Mostrar:ocultar contraseña
        togglePassword.addEventListener('click', function () {
          const esPassword = passwordInput.getAttribute('type') === 'password';
          passwordInput.setAttribute('type', esPassword ? 'text' : 'password');
          iconPassword.classList.toggle('bi-eye', !esPassword);
          iconPassword.classList.toggle('bi-eye-slash', esPassword);
        });

        // Guardar correo 
        formLogin.addEventListener('submit', function () {
          emailInput.value = emailInput.value.trim();

          if (rememberCheck.checked) {
            localStorage.setItem('hsc_correo_recordado', emailInput.value);
          } else {
            localStorage.removeItem('hsc_correo_recordado');
          }

          btnSubmit.disabled = true;
          btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Ingresando...';
        });
      });